# Fabric clocks generated by the Interface Designer PLL.
create_clock -period 6.667 -name pll_150Mhz [get_ports {pll_150Mhz}]
create_clock -period 41.667 -name pll_24Mhz [get_ports {pll_24Mhz}]

# Pointer synchronizers are the only intentional crossings between these clocks.
set_clock_groups -asynchronous \
    -group [get_clocks {pll_150Mhz}] \
    -group [get_clocks {pll_24Mhz}]
