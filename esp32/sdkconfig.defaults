# ESP32-C5 board uses a 16 MiB external QSPI flash.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_120M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ESP32-C5R8 provides 8 MiB of quad PSRAM. Keep normal malloc() in internal
# SRAM by default; frame/packet buffers opt in explicitly with
# heap_caps_malloc(..., MALLOC_CAP_SPIRAM). The C5R8 PSRAM is operated at its
# 120 MHz setting supported by ESP-IDF 6.1 for ESP32-C5.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_120M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_SPIRAM_MEMTEST=y

# GPIO13/GPIO14 are dedicated to the USB Serial/JTAG controller. Keep UART0
# free for the future flight-controller connection on GPIO11/GPIO12.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Video transport cannot tolerate modem sleep pauses.
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=32

CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
